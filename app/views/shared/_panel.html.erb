<%# Shared surface: same card used by the about sections and the experience entries. %>
<div class="relative rounded-2xl bg-neutral-900/40 border border-white/30 shadow-[0_0_20px_rgba(255,255,255,0.1)] <%= local_assigns.fetch(:padding, "p-12") %> hover:scale-[1.02] transition-all duration-300 overflow-hidden group" data-controller="gradient reveal">
  <div class="absolute inset-0 bg-radial from-white/8 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" data-gradient-target="gradient"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-transparent pointer-events-none"></div>
  <div class="relative z-10">
    <%= yield %>
  </div>
</div>
