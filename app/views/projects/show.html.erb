<% content_for :title, @project.name %>
<% content_for :description, @project.meta_description %>

<section class="max-w-3xl">
  <div class="text-sm text-neutral-400"><%= @project.period %></div>
  <h1 class="text-4xl font-bold mt-2"><%= @project.name %></h1>
  <p class="mt-4 text-neutral-400 leading-relaxed"><%= @project.summary %></p>

  <div class="mt-8 space-y-6">
    <div class="bg-neutral-900/40 border border-white/10 rounded-lg p-6">
      <h2 class="text-2xl font-semibold mb-4 text-white">Technologies used</h2>
      <div class="flex flex-wrap gap-2">
        <% @project.technologies.each do |technology| %>
          <span class="px-3 py-1 <%= technology_classes(technology) %> rounded-full text-sm"><%= technology[:name] %></span>
        <% end %>
      </div>
    </div>

    <div class="bg-neutral-900/40 border border-white/10 rounded-lg p-6">
      <h2 class="text-2xl font-semibold mb-4 text-white">Main features</h2>
      <ul class="space-y-2 text-neutral-300">
        <% @project.features.each do |feature| %>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-400 mt-1" aria-hidden="true"></i>
            <span><%= feature %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="bg-neutral-900/40 border border-white/10 rounded-lg p-6">
      <h2 class="text-2xl font-semibold mb-4 text-white">Links</h2>
      <div class="flex gap-4">
        <a href="<%= @project.link[:url] %>"
           target="_blank"
           rel="noopener noreferrer"
           class="flex items-center gap-2 text-neutral-300 hover:text-white transition-colors duration-300">
          <i class="<%= @project.link[:icon] %> fa-lg" aria-hidden="true"></i>
          <span><%= @project.link[:label] %></span>
        </a>
      </div>
    </div>
  </div>
</section>
