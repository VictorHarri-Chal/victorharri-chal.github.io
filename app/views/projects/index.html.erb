<% content_for :title, "Projects" %>
<% content_for :description, "NutriFlow, Vigie, NestioBnb and Scandela, plus the school projects behind them. Built with Ruby on Rails, Hotwire, React and C++." %>

<% large, small = @featured.partition(&:large?) %>

<section class="w-full">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <% large.each do |project| %>
        <article class="lg:col-span-1">
          <%= render "featured_card", project: project %>
        </article>
      <% end %>

      <div class="lg:col-span-1 flex flex-col gap-8 h-full">
        <% small.each do |project| %>
          <article class="flex-1 min-h-0">
            <%= render "featured_card", project: project %>
          </article>
        <% end %>
      </div>

    </div>
  </div>

  <section class="max-w-6xl mx-auto mt-16" aria-labelledby="school-projects-title">
    <header class="flex items-center mb-12">
      <div class="flex-1 h-px bg-white/10" aria-hidden="true"></div>
      <h2 id="school-projects-title" class="text-2xl font-semibold text-white px-8 mx-4">School projects</h2>
      <div class="flex-1 h-px bg-white/10" aria-hidden="true"></div>
    </header>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6" role="list" aria-label="School projects">
      <% @minor.each do |project| %>
        <article class="relative rounded-xl bg-neutral-900/40 border border-white/20 shadow-[0_0_15px_rgba(255,255,255,0.05)] p-6 transition-all duration-300 overflow-hidden group break-inside-avoid" data-controller="gradient reveal">
          <div class="absolute inset-0 bg-gradient-radial from-white/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" data-gradient-target="gradient"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-white/3 via-transparent to-transparent pointer-events-none"></div>
          <div class="relative z-10">
            <header class="flex justify-between items-start mb-3">
              <time class="text-xs text-neutral-400 font-medium" datetime="<%= project[:year] %>"><%= project[:year] %></time>
              <a href="<%= project[:url] %>" target="_blank" rel="noopener noreferrer" class="text-neutral-400 hover:text-white transition-colors duration-300" aria-label="View <%= project[:name] %> source code on GitHub">
                <i class="fa-brands fa-github text-sm" aria-hidden="true"></i>
              </a>
            </header>
            <h3 class="text-lg font-semibold mb-3 text-white"><%= project[:name] %></h3>
            <p class="text-sm text-neutral-300 leading-relaxed"><%= project[:description] %></p>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</section>
